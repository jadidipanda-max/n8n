# Modèle du fichier ~/.hermes/.env du compte « hermes » (secrets d'Hermès).
# scripts/installer-hermes.sh le remplit pour toi. Valeurs ci-dessous FACTICES.
# Droits du vrai fichier : lisible par « hermes » seulement (chmod 600).
# Noms vérifiés sur hermes-agent.nousresearch.com/docs (API Server > Configuration,
# AI Providers > Anthropic, MCP Config Reference) le 4 octobre 2026.

# --- API d'Hermès (compatible OpenAI) : jamais exposée sur Internet ---
API_SERVER_ENABLED=true
# Adresse d'écoute : la boucle locale seulement. Les conteneurs passent par le relais
# (deploy/hermes/relais-hermes.js), qui écoute sur le pont Docker et renvoie ici.
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
# Clé exigée dans « Authorization: Bearer … ». Même valeur que HERMES_API_KEY dans deploy/.env
# et que l'identifiant « Hermès API » dans n8n.
API_SERVER_KEY=a-remplacer-par-la-valeur-de-HERMES_API_KEY
# Nom sous lequel Hermès s'annonce (/v1/models). Même valeur que HERMES_MODEL dans deploy/.env.
API_SERVER_MODEL_NAME=hermes-agent

# --- Modèle Claude, payé à l'usage (console.anthropic.com > API Keys, avec un plafond de dépense) ---
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# --- MCP Supabase en lecture seule (utilisés dans config.yaml : ${SUPABASE_PROJECT_REF}, ${SUPABASE_ACCESS_TOKEN}) ---
# Référence du projet : le « abcdefghijklmnop » de https://abcdefghijklmnop.supabase.co
SUPABASE_PROJECT_REF=abcdefghijklmnop
# Jeton personnel Supabase (supabase.com > Account > Access Tokens), limité au projet J-Square
# et aux droits de lecture de la base si l'écran le propose. ATTENTION : un jeton sbp_ ouvre
# l'API d'administration de tout le compte Supabase. La lecture seule vient du MCP
# (read_only=true) ; c'est pour ça qu'Hermès n'a ni terminal ni accès aux fichiers
# (config.yaml : platform_toolsets et agent.disabled_toolsets) et ne peut pas lire ce fichier.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
