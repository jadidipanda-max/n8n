# Réglages du cockpit J-Square sur le serveur (docker compose les lit dans deploy/.env).
#
# NE REMPLIS PAS CE FICHIER-CI : c'est un modèle avec des valeurs FACTICES.
# Lance plutôt :  bash scripts/configurer.sh
# Le script crée deploy/.env (lisible par toi seul), génère les clés et te pose les questions.
# Tu peux ensuite corriger une valeur à la main :  nano .env  puis  docker compose up -d
#
# Règles d'écriture : une ligne par réglage, NOM=valeur, sans espace autour du « = ».
# Ne mets jamais ce fichier .env dans git ni dans un e-mail : il contient des secrets.

# ─── Domaine et HTTPS (Caddy) ────────────────────────────────────────────────
# Ton nom de domaine, sans « https:// » ni « www ». Le cockpit sera sur cockpit.<domaine>
# et n8n sur n8n.<domaine> (les deux enregistrements DNS de l'étape 2 du guide).
DOMAINE=jsquare-exemple.fr
# Ton e-mail : Let's Encrypt l'utilise pour les certificats HTTPS (alertes d'expiration).
EMAIL_ACME=jay@jsquare-exemple.fr

# ─── Serveur du cockpit (contrat technique, section 2) ───────────────────────
# Port interne du cockpit (Caddy s'y branche tout seul). Ne change pas.
PORT=8080
# Adresse du projet Supabase (Supabase > Project Settings > Data API > Project URL).
# Laisse vide tant que Supabase n'est pas prêt : le cockpit s'affiche alors en mode démo.
SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# Clé publique « sb_publishable_… » (Project Settings > API Keys). Elle est envoyée au navigateur :
# ce n'est pas un secret, les droits (RLS) protègent les données.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Clé secrète « sb_secret_… » réservée au cockpit (Project Settings > API Keys > Secret keys,
# nom « cockpit »). Elle reste sur le serveur et sert à enregistrer les réponses d'Hermès.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Adresse de l'API Hermès vue depuis les conteneurs. Ne change pas.
# host.docker.internal = le serveur lui-même ; le relais « relais-hermes » y écoute et
# renvoie vers Hermès (127.0.0.1:8642). Voir le guide, étape 6.
HERMES_URL=http://host.docker.internal:8642
# Clé de l'API Hermès (longue chaîne aléatoire). configurer.sh la génère ; installer-hermes.sh
# la recopie dans Hermès (API_SERVER_KEY). Tu la colleras aussi dans n8n (identifiant « Hermès API »).
HERMES_API_KEY=a-remplacer-par-une-longue-cle-aleatoire
# Nom du modèle envoyé à Hermès. Ne change pas (Hermès s'annonce sous ce nom).
HERMES_MODEL=hermes-agent
# 1 = forcer le mode démo (données d'exemple, sans connexion). 0 = normal.
DEMO=0

# ─── n8n ─────────────────────────────────────────────────────────────────────
# Clé qui chiffre les identifiants enregistrés dans n8n (64 caractères aléatoires).
# configurer.sh la génère. Ne la change JAMAIS ensuite : n8n ne pourrait plus lire ses identifiants.
# Garde-la aussi dans ton gestionnaire de mots de passe.
N8N_ENCRYPTION_KEY=a-remplacer-par-une-cle-aleatoire-de-64-caracteres
# Compte propriétaire de n8n créé d'avance (configurer.sh remplit ces lignes et passe la première à true).
# Tant que la première ligne vaut true, le mot de passe n8n se change avec :
#   bash scripts/configurer.sh --mot-de-passe-n8n
N8N_INSTANCE_OWNER_MANAGED_BY_ENV=false
N8N_INSTANCE_OWNER_EMAIL=jay@jsquare-exemple.fr
N8N_INSTANCE_OWNER_FIRST_NAME=Jay
N8N_INSTANCE_OWNER_LAST_NAME=J-Square
# Empreinte (bcrypt) du mot de passe, jamais le mot de passe lui-même. Entre apostrophes.
N8N_INSTANCE_OWNER_PASSWORD_HASH=

# ─── Relais vers Hermès ──────────────────────────────────────────────────────
# Adresse du pont Docker (docker0) sur le serveur : c'est là qu'écoute le relais.
# configurer.sh la vérifie et la corrige au besoin. Ne change pas.
HERMES_RELAIS_IP=172.17.0.1
